# ==========================================================================
# Reserved. – Startseite über _reserved/gate.php (Inhalte aus dem Admin),
# Admin-Bereich: /admin/   ·   PHP 8.1 oder neuer nötig (z. B. IONOS)
# Liegt die Seite in einem Unterordner, RewriteBase anpassen.
# ==========================================================================
DirectoryIndex index.html index.php
Options -Indexes
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # HTTPS erzwingen
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^localhost
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule ^(admin|_reserved)(/|$) - [L]
  RewriteRule ^$ _reserved/gate.php [L,QSA]
  RewriteRule ^index\.html?$ _reserved/gate.php [L,QSA]
  # Landingpage
  RewriteRule ^angebot$ angebot/ [R=301,L]
  RewriteRule ^angebot/(index\.html?)?$ _reserved/gate.php [L,QSA]
  # Funnel: Download & Danke-Seite
  RewriteRule ^plan$ plan/ [R=301,L]
  RewriteRule ^plan/(index\.html?)?$ _reserved/gate.php [L,QSA]
  RewriteRule ^plan/danke$ plan/danke/ [R=301,L]
  RewriteRule ^plan/danke/(index\.html?)?$ _reserved/gate.php [L,QSA]
  # Über mich
  RewriteRule ^ueber-mich$ ueber-mich/ [R=301,L]
  RewriteRule ^ueber-mich/(index\.html?)?$ _reserved/gate.php [L,QSA]
  # Fit-Check „Zusammenarbeit starten“
  RewriteRule ^start$ start/ [R=301,L]
  RewriteRule ^start/(index\.html?)?$ _reserved/gate.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(woff2|webp|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
